{
  "phishlensTeams": {
    "$team": {
      ".read": "auth != null && (root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'member' || root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'admin')",
      ".write": "auth != null && !data.exists() && newData.hasChildren(['name','owner','members']) && !newData.child('reviews').exists() && newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).val() === 'admin'",
      "name": {
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
      },
      "owner": {
        ".validate": "newData.isString() && newData.val() === auth.uid"
      },
      "members": {
        "$member": {
          ".write": "auth != null && root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'admin' && ($member !== root.child('phishlensTeams').child($team).child('owner').val() || newData.val() === 'admin')",
          ".validate": "(root.child('phishlensTeams').child($team).exists() || $member === auth.uid) && newData.isString() && (newData.val() === 'admin' || newData.val() === 'member')"
        }
      },
      "reviews": {
        ".indexOn": [
          "submittedAt"
        ],
        "$review": {
          ".write": "auth != null && ((!newData.exists() && root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'admin') || (newData.exists() && ((root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'member' || root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'admin') && !data.exists() && newData.child('submittedBy').val() === auth.uid && newData.child('status').val() === 'unresolved' && newData.child('notes').val() === '' && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= now - 60000 && newData.child('updatedAt').val() <= now + 60000 && newData.child('submittedAt').val() === newData.child('updatedAt').val() || root.child('phishlensTeams').child($team).child('members').child(auth.uid).val() === 'admin' && data.exists() && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= now - 60000 && newData.child('updatedAt').val() <= now + 60000)))",
          ".validate": "newData.hasChildren(['url','hostname','sender','message','displayed','status','notes','submittedBy','submittedAt','updatedBy','updatedAt'])",
          "url": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4096 && (!data.exists() || newData.val() === data.val())"
          },
          "hostname": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 253 && (!data.exists() || newData.val() === data.val())"
          },
          "sender": {
            ".validate": "newData.isString() && newData.val().length <= 320 && (!data.exists() || newData.val() === data.val())"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 10000 && (!data.exists() || newData.val() === data.val())"
          },
          "displayed": {
            ".validate": "newData.isString() && newData.val().length <= 4096 && (!data.exists() || newData.val() === data.val())"
          },
          "submittedBy": {
            ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())"
          },
          "submittedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'unresolved' || newData.val() === 'suspicious' || newData.val() === 'legitimate')"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
