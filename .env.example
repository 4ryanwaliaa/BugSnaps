# Optional override for the BugSnaps stream (default: G-GQWKB7QXXY).
# Set explicitly to an empty value to disable analytics.
# Configure Enhanced Measurement OFF before setting this. See README.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GQWKB7QXXY

# MyPentest engine URL; configured only on the server.
MYPENTEST_ENGINE_URL=

# EndpointRadar managed service: server-only values. See docs/endpointradar/managed.md.
ENDPOINTRADAR_DATABASE_URL=
ENDPOINTRADAR_SERVICE_ACCOUNT_JSON=
# Set only after checking effective root and /endpointRadar client-deny rules.
ENDPOINTRADAR_DATABASE_LOCKED=false
# Use the same random secret as the GitHub ENDPOINTRADAR_CRON_SECRET.
CRON_SECRET=
